# Copy to .env (or set in your hosting dashboard). No secrets are required.
PORT=8080
HOST=0.0.0.0
# Where the SQLite database lives. Must be a persistent disk.
DATA_DIR=./server/data
# Comma-separated emails that get the admin page (/admin.html) once they register.
ADMIN_EMAILS=hossam198012@gmail.com
# Set to 0 to stop new sign-ups.
ALLOW_REGISTRATION=1
# Set to 1 when running behind Nginx/Caddy/a cloud load balancer that terminates HTTPS.
TRUST_PROXY=0
# Force the Secure cookie flag (also set automatically behind an HTTPS proxy when TRUST_PROXY=1).
COOKIE_SECURE=0
